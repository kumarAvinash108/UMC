# --- Sync service ---
PORT=3000
DATABASE_URL=postgres://ucm:ucm@localhost:5432/ucm
# If empty, service uses in-memory store (dev / local-network mode)
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-value
# Comma-separated CORS origins for local dev
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Limits (v1 defaults per plan)
MAX_ITEM_BYTES=65536
MAX_HISTORY_PER_USER=1000
DEFAULT_EXPIRY_DAYS=7
RATE_LIMIT_PER_MIN=120

# --- Linux agent (apps/linux/.env / systemd EnvironmentFile) ---
UCM_SERVER_URL=http://localhost:3000
UCM_DEVICE_NAME=my-linux
UCM_DATA_DIR=~/.local/share/ucm
UCM_SYNC_ENABLED=true

# --- Android (apps/android/.env) ---
# A PHYSICAL phone cannot reach `localhost` (that's the phone itself).
# Use this PC's LAN IP so Expo Go can reach the sync service:
#   EXPO_PUBLIC_SYNC_URL=http://192.168.1.5:3000   (find yours with `hostname -I`)
EXPO_PUBLIC_SYNC_URL=http://localhost:3000

{
  "name": "universal-clipboard",
  "version": "0.1.0",
  "private": true,
  "description": "Private E2E-encrypted clipboard manager for Linux (Ubuntu/Fedora) + Android",
  "workspaces": [
    "packages/protocol",
    "services/sync",
    "apps/android"
  ],
  "scripts": {
    "setup-and-run": "bash ./setup-and-run.sh",
    "validate": "bash scripts/validate.sh",
    "protocol:test": "npm run test --workspace=@ucm/protocol",
    "sync:test": "npm run test --workspace=@ucm/sync-service",
    "sync:dev": "npm run dev --workspace=@ucm/sync-service",
    "dev": "bash ./scripts/start-dev.sh",
    "dev:sync": "bash ./scripts/start-dev.sh --sync-only",
    "dev:android": "bash ./scripts/start-dev.sh --android-only",
    "dev:linux": "bash ./scripts/start-dev.sh --linux-only",
    "lint": "npx prettier --check . && npx tsc --noEmit -p tsconfig.base.json || true"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
